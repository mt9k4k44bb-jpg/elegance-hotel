
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap');

:root {
  --green: #183c30;
  --deep-green: #10281f;
  --gold: #c8a96b;
  --cream: #f7f3eb;
  --ink: #252b25;
  --muted: #77786e;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 85px;
}

body {
  margin: 0;
  background: var(--cream);
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
  line-height: 1.7;
}

a {
  color: inherit;
  text-decoration: none;
}

.site-header {
  min-height: 82px;
  padding: 18px 6%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 25px;
  background: var(--cream);
  border-bottom: 1px solid #e6dfd2;
  position: sticky;
  top: 0;
  z-index: 10;
}

.logo {
  font-family: 'Playfair Display', serif;
  font-size: 25px;
  letter-spacing: 2px;
  color: var(--green);
  white-space: nowrap;
}

.site-header nav {
  display: flex;
  align-items: center;
  gap: 25px;
}

.site-header nav a {
  font-size: 12px;
  transition: color .2s;
}

.site-header nav a:hover {
  color: #a27e3d;
}

.menu-toggle {
  display: none;
  border: 1px solid #d9cfbd;
  background: transparent;
  padding: 9px 13px;
  color: var(--green);
  cursor: pointer;
}

.hero {
  min-height: 600px;
  display: flex;
  align-items: center;
  padding: 80px 9%;
  color: white;
  background:
    linear-gradient(90deg, rgba(12, 34, 25, .96) 0%, rgba(18, 48, 35, .83) 48%, rgba(12, 34, 25, .18) 100%),
    url('https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=1800&q=85') center/cover;
}

.hero-content {
  max-width: 620px;
}

.eyebrow {
  color: var(--gold);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2.5px;
  line-height: 1.8;
}

.hero h1,
.section h2,
.experience h2 {
  font-family: 'Playfair Display', serif;
  font-weight: 500;
  line-height: 1.13;
}

.hero h1 {
  font-size: clamp(43px, 6vw, 76px);
  margin: 22px 0;
}

h1 em,
h2 em {
  color: var(--gold);
  font-weight: 500;
}

.hero-content > p:not(.eyebrow) {
  max-width: 440px;
  color: #e3e6df;
  font-size: 15px;
  margin-bottom: 30px;
}

.gold-button {
  display: inline-block;
  padding: 14px 23px;
  background: var(--gold);
  color: #17281e;
  border: 1px solid var(--gold);
  font: 600 11px 'DM Sans', sans-serif;
  letter-spacing: 1px;
  text-align: center;
  cursor: pointer;
  transition: .25s;
}

.gold-button:hover {
  background: transparent;
  color: var(--gold);
}

.section {
  padding: 90px 7%;
  text-align: center;
}

.section h2,
.experience h2 {
  font-size: clamp(36px, 4.5vw, 52px);
  margin: 12px 0;
}

.section h2 em {
  color: var(--green);
}

.section-intro {
  color: var(--muted);
  font-size: 14px;
  max-width: 560px;
  margin: 15px auto 38px;
}

.card-grid {
  max-width: 1200px;
  margin: 42px auto 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
  text-align: left;
}

.card {
  background: #fffdf8;
  border: 1px solid #eae2d5;
  overflow: hidden;
  transition: transform .25s, box-shadow .25s;
}

.card:hover {
  transform: translateY(-5px);
  box-shadow: 0 15px 35px rgba(24, 60, 48, .10);
}

.card img {
  display: block;
  width: 100%;
  height: 240px;
  object-fit: cover;
  background: #e4e0d5;
}

.card-info {
  padding: 23px;
}

.label {
  color: #947540;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 1.7px;
}

.card h3 {
  font: 500 23px 'Playfair Display', serif;
  color: var(--green);
  margin: 12px 0 8px;
}

.card-info p {
  color: var(--muted);
  font-size: 13px;
  margin-bottom: 0;
}

.suites-section {
  background: #eeeadf;
}

.experience {
  padding: 75px 9%;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: center;
  gap: 45px;
  background: var(--green);
  color: white;
}

.experience h2 {
  margin-bottom: 0;
}

.experience > p {
  color: #dce4dc;
  font-size: 15px;
  line-height: 2;
  max-width: 460px;
}

.booking-section {
  background: var(--cream);
}

#booking-form {
  max-width: 620px;
  margin: 35px auto 0;
  padding: 35px;
  background: white;
  border: 1px solid #e6dfd2;
  text-align: left;
  box-shadow: 0 12px 35px rgba(20, 40, 25, .04);
}

#booking-form label {
  display: block;
  margin: 17px 0 7px;
  color: var(--green);
  font-size: 12px;
  font-weight: 600;
}

#booking-form input,
#booking-form select,
#booking-form textarea {
  width: 100%;
  display: block;
  padding: 13px 14px;
  border: 1px solid #dcd8ce;
  border-radius: 0;
  background: #fdfcf9;
  color: var(--ink);
  font: 13px 'DM Sans', sans-serif;
}

#booking-form input:focus,
#booking-form select:focus,
#booking-form textarea:focus {
  outline: 2px solid #b4c5b8;
  border-color: var(--green);
}

#booking-form textarea {
  resize: vertical;
}

.submit-button {
  width: 100%;
  margin-top: 22px;
}

#form-message {
  font-size: 13px;
  color: var(--green);
}

.form-note {
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

footer {
  padding: 45px 20px 25px;
  background: var(--deep-green);
  color: #f5f1e8;
  text-align: center;
}

footer .logo {
  color: white;
}

footer p {
  font-size: 12px;
  color: #c8d0c7;
}

.creator-credit {
  margin-top: 25px;
  color: var(--gold);
}

.copyright {
  padding-top: 12px;
  font-size: 10px;
  color: #aebbb0;
}

@media (max-width: 850px) {
  .site-header {
    padding: 16px 5%;
    flex-wrap: wrap;
  }

  .menu-toggle {
    display: block;
  }

  .site-header nav {
    display: none;
    width: 100%;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
  }

  .site-header nav.open {
    display: flex;
  }

  .site-header nav a {
    padding: 12px 0;
    border-top: 1px solid #e6dfd2;
  }

  .card-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
  }

  .experience {
    grid-template-columns: 1fr;
    gap: 15px;
  }
}

@media (max-width: 540px) {
  .logo {
    font-size: 21px;
  }

  .hero {
    min-height: 540px;
    padding: 65px 7%;
    background-position: 58% center;
  }

  .hero h1 {
    font-size: 45px;
  }

  .section {
    padding: 65px 6%;
  }

  .card-grid {
    grid-template-columns: 1fr;
    max-width: 380px;
  }

  .card img {
    height: 230px;
  }

  .experience {
    padding: 60px 7%;
  }

  #booking-form {
    padding: 22px 18px;
  }
}
